{
  "name": "sous-chefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Firefox extension for unit conversions and calculations in recipes.",
  "scripts": {
    "build": "vite build",
    "start": "vite build && web-ext run",
    "lint": "vite build && web-ext lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "web-ext": "^10.8.0"
  }
}
