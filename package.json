{
  "name": "sous-chefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Firefox extension for unit conversions and calculations in recipes.",
  "scripts": {
    "prebuild": "node scripts/check-node.mjs",
    "build": "vite build && vite build --mode popup && vite build --mode background",
    "start": "npm run build && web-ext run",
    "lint": "npm run build && web-ext lint",
    "release": "npm run lint && web-ext build --overwrite-dest",
    "pretypecheck": "node scripts/check-node.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "prefixture": "node scripts/check-node.mjs",
    "fixture": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA scripts/fixture.mjs",
    "predump": "node scripts/check-node.mjs",
    "dump": "node scripts/dump.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "web-ext": "^10.8.0"
  }
}
